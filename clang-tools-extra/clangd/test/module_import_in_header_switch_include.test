# Regression test: switching an include from a header that imports a module
# to one that does not must invalidate stale module visibility.
#
# Windows have different escaping modes.
# FIXME: We should add one for windows.
# UNSUPPORTED: system-windows
#
# RUN: rm -rf %t
# RUN: mkdir -p %t
# RUN: split-file %s %t
#
# RUN: sed -e "s|DIR|%/t|g" %t/compile_commands.json.tmpl > %t/compile_commands.json.tmp
# RUN: sed -e "s|CLANG_CC|%clang|g" %t/compile_commands.json.tmp > %t/compile_commands.json
# RUN: sed -e "s|DIR|%/t|g" %t/definition.jsonrpc.tmpl > %t/definition.jsonrpc
#
# RUN: clangd -experimental-modules-support -lit-test -sync=0 < %t/definition.jsonrpc \
# RUN:      2> %t.err | tee %t.out | FileCheck -strict-whitespace %s --check-prefix=OUT
# RUN: grep -F "\"code\": \"undeclared_var_use\"" %t.out | count 1
# RUN: grep -F "\"version\": 2" %t.out | count 1

#--- A.cppm
export module A;
export void printA() {}

#--- HeaderWithImport.h
import A;

#--- HeaderWithoutImport.h
// no import here

#--- Use.cpp
#include "HeaderWithImport.h"
void foo() {
    printA();
}

#--- compile_commands.json.tmpl
[
    {
      "directory": "DIR",
      "command": "CLANG_CC -std=c++20 -I DIR -o DIR/main.cpp.o -c DIR/Use.cpp",
      "file": "DIR/Use.cpp"
    },
    {
      "directory": "DIR",
      "command": "CLANG_CC -std=c++20 DIR/A.cppm --precompile -o DIR/A.pcm",
      "file": "DIR/A.cppm"
    }
]

#--- definition.jsonrpc.tmpl
{
  "jsonrpc": "2.0",
  "id": 0,
  "method": "initialize",
  "params": {
    "processId": 123,
    "rootPath": "clangd",
    "capabilities": {},
    "trace": "off"
  }
}
---
{
  "jsonrpc": "2.0",
  "method": "textDocument/didOpen",
  "params": {
    "textDocument": {
      "uri": "file://DIR/Use.cpp",
      "languageId": "cpp",
      "version": 1,
      "text": "#include \"HeaderWithImport.h\"\nvoid foo() {\n    printA();\n}\n"
    }
  }
}
---
{"jsonrpc":"2.0","id":1,"method":"sync","params":{}}
---
{
  "jsonrpc": "2.0",
  "method": "textDocument/didChange",
  "params": {
    "textDocument": {
      "uri": "file://DIR/Use.cpp",
      "version": 2
    },
    "contentChanges": [
      {
        "text": "#include \"HeaderWithoutImport.h\"\nvoid foo() {\n    printA();\n}\n"
      }
    ]
  }
}
---
{"jsonrpc":"2.0","id":2,"method":"sync","params":{}}
---
{"jsonrpc":"2.0","id":3,"method":"shutdown"}
---
{"jsonrpc":"2.0","method":"exit"}

# OUT: "method": "textDocument/publishDiagnostics"
# OUT: "code": "undeclared_var_use"
# OUT: "message": "Use of undeclared identifier 'printA'"
# OUT: "version": 2
# OUT: "id": 2,
# OUT-NEXT:  "jsonrpc": "2.0",
# OUT-NEXT:  "result": null
